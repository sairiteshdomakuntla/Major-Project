{
  "expo": {
    "name": "AgentBridge",
    "slug": "agentbridge",
    "scheme": "agentbridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AgentBridge to use the camera so it can describe what is in front of you."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow AgentBridge to use the microphone so you can control it with your voice.",
          "speechRecognitionPermission": "Allow AgentBridge to recognize your speech for voice commands.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ]
  }
}
