# Copy to .env for local development.
# Android emulator: the emulator's localhost is NOT your PC.
#   Use http://10.0.2.2:4000
# Physical Android device (same Wi-Fi as PC):
#   Use your PC's LAN IP, e.g. http://192.168.1.50:4000
# iOS simulator / Web:
#   Use http://localhost:4000
# Future production:
#   Use your deployed HTTPS URL, e.g. https://api.agentbridge.example.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
