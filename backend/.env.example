# AgentBridge API configuration
# Copy to .env for local development: copy .env.example .env (Windows) / cp .env.example .env (macOS/Linux)
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*
LOG_LEVEL=dev

# --- Assistant (Gemini) ---
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
# Required for POST /api/v1/assistant/message (returns 503 without it).
# Never commit real keys — put them in backend/.env (gitignored), not here.
GEMINI_API_KEY=
# Configurable model; override without code changes.
# Prefer a pinned stable model (e.g. gemini-2.5-flash): the rolling
# *-latest aliases can return 503 "high demand" under load.
GEMINI_MODEL=gemini-2.5-flash
# Provider timeout in milliseconds
GEMINI_TIMEOUT_MS=25000
# Vision requests carry images — allow longer
GEMINI_VISION_TIMEOUT_MS=60000
